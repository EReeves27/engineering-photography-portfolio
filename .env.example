# Portfolio (Vite) — copy to .env and fill in after deploying the Worker
# Local dev with `npm run spotify:dev` in another terminal:
# VITE_SPOTIFY_RECENT_URL=/api/spotify/recent
# Production (your deployed Worker URL):
# VITE_SPOTIFY_RECENT_URL=https://eng-spotify-vinyl.ethanhreeves.workers.dev/recent
# (optional — same URL is the default in src/engineering/config.js)

VITE_SPOTIFY_RECENT_URL=

# Photography contact forms (Formspree). Default is in src/photography/config.js.
# VITE_FORMSPREE_URL=https://formspree.io/f/mykvwlew

# Used only by `npm run spotify:auth` (not sent to the browser)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
